#!/usr/bin/env bash
# Fast feedback loop for the fork: rubocop on our files + spec/custom + upstream specs touched by our changes.
# The full upstream suite runs only when merging a new upstream release (see crm/PRD.md).
set -euo pipefail
cd "$(dirname "$0")/../.."

# Upstream specs covering upstream files we changed or extend (keep in sync with crm/docs/core-changes.md).
UPSTREAM_SPECS=(
  spec/dispatchers/async_dispatcher_spec.rb
  spec/controllers/api/v1/accounts/actions/contact_merges_controller_spec.rb
  spec/finders/notification_finder_spec.rb
  spec/policies/company_policy_spec.rb
  spec/builders/notification_builder_spec.rb
  spec/controllers/api/v1/accounts/contacts
  spec/controllers/api/v1/accounts/contacts_controller_spec.rb
  spec/controllers/api/v1/accounts/conversations_controller_spec.rb
  spec/controllers/api/v1/accounts/bulk_actions_controller_spec.rb
  spec/controllers/api/v1/accounts/canned_responses_controller_spec.rb
  spec/controllers/api/v1/accounts_controller_spec.rb
  spec/controllers/api/v1/accounts/search_controller_spec.rb
  spec/finders/conversation_finder_spec.rb
  spec/listeners/action_cable_listener_spec.rb
  spec/policies/conversation_policy_spec.rb
  spec/services/conversations/permission_filter_service_spec.rb
  spec/services/search_service_spec.rb
)

bundle exec rubocop custom spec/custom config/application.rb app/controllers/api/v1/accounts/base_controller.rb app/controllers/api/v1/accounts/contacts/base_controller.rb \
  app/controllers/api/v1/accounts/actions/contact_merges_controller.rb app/finders/notification_finder.rb \
  app/controllers/api/v1/accounts/bulk_actions_controller.rb db/migrate/20261123062525_create_crm_hidden_conversations.rb \
  db/migrate/20261123092416_create_crm_invitations.rb db/migrate/20261123100359_create_crm_templates.rb \
  app/controllers/api/v1/accounts/canned_responses_controller.rb app/controllers/dashboard_controller.rb
# Frontend files we changed and their specs (upstream's own spec included: our handler lives in its file).
pnpm exec eslint app/javascript/dashboard/helper/actionCable.js app/javascript/dashboard/helper/specs/crmActionCable.spec.js \
  app/javascript/crm app/javascript/entrypoints/crm.js
pnpm exec vitest run app/javascript/dashboard/helper/specs/actionCable.spec.js app/javascript/dashboard/helper/specs/crmActionCable.spec.js \
  app/javascript/crm/specs
bundle exec rspec spec/custom "${UPSTREAM_SPECS[@]}" "$@"
