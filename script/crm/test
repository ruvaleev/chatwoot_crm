#!/usr/bin/env bash
# Fast feedback loop for the fork: rubocop on our files + spec/custom + upstream specs touched by our changes.
# The full upstream suite runs only when merging a new upstream release (see crm/PRD.md).
set -euo pipefail
cd "$(dirname "$0")/../.."

# Upstream specs covering upstream files we changed or extend (keep in sync with crm/docs/core-changes.md).
UPSTREAM_SPECS=(
  spec/dispatchers/async_dispatcher_spec.rb
  spec/builders/notification_builder_spec.rb
  spec/controllers/api/v1/accounts/contacts
  spec/controllers/api/v1/accounts/contacts_controller_spec.rb
  spec/controllers/api/v1/accounts/conversations_controller_spec.rb
  spec/controllers/api/v1/accounts/search_controller_spec.rb
  spec/finders/conversation_finder_spec.rb
  spec/listeners/action_cable_listener_spec.rb
  spec/policies/conversation_policy_spec.rb
  spec/services/conversations/permission_filter_service_spec.rb
  spec/services/search_service_spec.rb
)

bundle exec rubocop custom spec/custom config/application.rb app/controllers/api/v1/accounts/base_controller.rb app/controllers/api/v1/accounts/contacts/base_controller.rb
bundle exec rspec spec/custom "${UPSTREAM_SPECS[@]}" "$@"
